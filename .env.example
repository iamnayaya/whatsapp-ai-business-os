# ============================================================================
# WhatsApp AI Business OS — required environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All keys are validated at boot (see packages/shared/src/env.ts).
# ============================================================================

# --- Server ---
NODE_ENV=development
# HTTP port for the API (webhook receiver + health endpoint)
PORT=3000
# Path Meta POSTs webhook events to (and GETs verification to)
WEBHOOK_PATH=/webhook/whatsapp

# --- Database (PostgreSQL 16) ---
# Local: matches docker-compose.yml. Production: Render/Railway/Supabase URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_biz_os

# --- Redis (for BullMQ queues + rate limiting) ---
# Local: matches docker-compose.yml. Production: Render/Railway/Upstash Redis.
REDIS_URL=redis://localhost:6379

# --- WhatsApp Business (Meta Cloud API) ---
# From the Meta Developer App dashboard: WhatsApp product settings.
# Do NOT use a personal WhatsApp — use the app's long-lived system-user token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (optional but useful for audit filtering)
WHATSAPP_WABA_ID=
# Random string you choose; Meta sends it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Meta App Secret (used to verify webhook signature X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Current stable Graph API version for WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0

# --- AI (Phase 2 — Sales Agent) ---
# Google AI Studio / Vertex: https://aistudio.google.com/apikey
# Required only when running the WORKER (the Sales Agent needs it); the API
# (webhook receiver + health) runs without it.
# The SAME key powers Phase 3 voice-note transcription (Gemini native audio).
GEMINI_API_KEY=
# Flash model to use (fast + cheap). Override to pin a specific version.
GEMINI_MODEL=gemini-flash-latest
# Minimum transcription confidence (0..1) before a voice note is treated as
# clearly understood. Below this the agent asks the customer to repeat.
TRANSCRIBER_MIN_CONFIDENCE=0.5

# --- Follow-ups (Phase 5 — abandoned-cart engine) ---
# Cron pattern (6-field, seconds first) for the BullMQ repeatable scan job.
# Every 15 minutes is fine for a sub-1000-order shop.
FOLLOWUP_SCAN_CRON=0 */15 * * * *
# How long a conversation must be quiet before the 1st nudge / final nudge
# (minutes since the customer's last inbound message).
FOLLOWUP_FIRST_DELAY_MINUTES=120
FOLLOWUP_SECOND_DELAY_MINUTES=1440
# Never send outside this local-hours window (uses the business timezone —
# the same country-wide, so it doubles as the customer's local time for now).
# Set both to the same value (e.g. 0 and 0) to disable quiet hours.
FOLLOWUP_QUIET_START=21
FOLLOWUP_QUIET_END=9
# Hard cap on follow-ups per abandoned cart (never spam past this).
FOLLOWUP_MAX_ATTEMPTS=2

# --- Multi-agent orchestration (Phase 6) ---
# The support agent escalates refund requests above this amount (in the
# business currency) to a human, instead of approving them itself.
REFUND_ESCALATION_THRESHOLD=50000

# --- Business defaults (used to auto-provision on first webhook) ---
BUSINESS_NAME=My Business
# The WhatsApp number the business runs on, e.g. 2348012345678
BUSINESS_PHONE_NUMBER=
BUSINESS_CURRENCY=NGN
BUSINESS_TIMEZONE=Africa/Lagos

# --- Paystack payments (Phase 7) ---
# Optional — the payment tool and webhook simply refuse to work when missing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Owner Analytics Dashboard (Phase 8) ---
# Internal, password-protected dashboard at GET /admin. Only served when
# ADMIN_PASSWORD is set (unset = dashboard disabled / 404). Choose a long,
# random password — it is compared constant-time and never stored.
ADMIN_PASSWORD=
# Optional; signs the login cookie. Defaults to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=
# Optional read-only Postgres URL for the dashboard (e.g. a replica, or a role
# granted SELECT only). When set, the dashboard queries THIS, never the primary
# write URL — guaranteeing the dashboard cannot corrupt data. Unset = reuses
# DATABASE_URL (still read-only: the dashboard issues only SELECT queries).
ANALYTICS_DATABASE_URL=

# ============================================================================
# Deployment & ops (Phase 9) — monitoring, alerting, and the AI kill switch.
# ============================================================================

# --- Error-spike monitoring (runs inside the WORKER) ---
# Every MONITOR_INTERVAL_MINUTES the worker counts, over the last
# MONITOR_WINDOW_MINUTES, how many: messages FAILED, webhook events FAILED,
# webhook events stuck PENDING, and Gemini API errors (a Redis counter the AI
# client increments). Any count at/above its threshold fires an alert, but only
# once per MONITOR_ALERT_COOLDOWN_MINUTES per distinct problem.
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=5
MONITOR_WINDOW_MINUTES=15
MONITOR_FAILED_MESSAGES_THRESHOLD=5
MONITOR_FAILED_EVENTS_THRESHOLD=3
# Events stuck unprocessed longer than this are treated as a stalled pipeline.
MONITOR_PENDING_BACKLOG_MINUTES=10
MONITOR_PENDING_BACKLOG_THRESHOLD=5
MONITOR_AI_ERROR_THRESHOLD=10
MONITOR_ALERT_COOLDOWN_MINUTES=30

# --- Alert channels (at least one; Slack is the recommended primary) ---
# Slack incoming webhook URL: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional second channel — email via the built-in SMTP client.
# With Gmail use port 465 + secure=true + an app password; with most providers
# port 587 + STARTTLS (secure=false) and the SMTP username/password.
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=owner@yourdomain.com
ALERT_SMTP_HOST=smtp.yourdomain.com
ALERT_SMTP_PORT=587
# true = implicit TLS (port 465); false/blank = STARTTLS upgrade (port 587).
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

# --- AI-agent kill switch (Redis-backed, toggled via the admin API) ---
# When active, the worker answers every customer message with a static
# "we'll reply shortly" fallback and does NOT call Gemini — while webhooks,
# payments, and follow-ups keep running. Toggle from the dashboard API:
#   POST /admin/ops/kill-switch  {"enabled": true}   # pause the AI agent
#   POST /admin/ops/kill-switch  {"enabled": false}  # resume
# Emergency failsafe (Redis CLI): SET ops:kill-switch 1  /  DEL ops:kill-switch
# No env var is needed to use the kill switch itself; ADMIN_PASSWORD above
# protects the toggle endpoint.
