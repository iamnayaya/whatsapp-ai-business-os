{
  "name": "whatsapp-ai-business-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered WhatsApp Business automation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "dev:api": "ts-node -P tsconfig.json apps/api/src/main.ts",
    "dev:worker": "ts-node -P tsconfig.json apps/worker/src/main.ts",
    "admin:catalog": "ts-node -P tsconfig.json apps/admin/src/main.ts",
    "admin:delivery": "ts-node -P tsconfig.json apps/admin/src/delivery.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "db:generate": "npm run generate -w @wabiz/db",
    "db:migrate": "npm run migrate -w @wabiz/db",
    "db:deploy": "npm run migrate:deploy -w @wabiz/db",
    "db:seed": "npm run seed -w @wabiz/db"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}
